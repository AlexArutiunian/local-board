# AI provider for formula OCR: openrouter (default) or local.
LOCAL_BOARD_AI_PROVIDER=openrouter

# OpenRouter mode.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_FORMULA_MODEL=stealth/ox-alpha

# Local mode: compatible with ubuntu_voice_chat feature/web-ai-shell.
# Start the Local AI Shell first and then set LOCAL_BOARD_AI_PROVIDER=local.
LOCAL_AI_BASE_URL=http://127.0.0.1:8787/v1
LOCAL_AI_MODEL=local
LOCAL_AI_API_KEY=local
