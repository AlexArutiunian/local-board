# Copy this file to .env and replace the placeholder with your OpenRouter key.
# .env is gitignored and must never be committed.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Formula OCR is intentionally restricted to explicit :free OpenRouter models.
# Current math-focused multimodal default (Aug 2026):
OPENROUTER_FORMULA_MODEL=qwen/qwen2.5-vl-32b-instruct:free
