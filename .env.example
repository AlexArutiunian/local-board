# Copy this file to .env and replace the placeholder with your OpenRouter key.
# .env is gitignored and must never be committed.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Formula OCR is intentionally restricted to explicit :free OpenRouter models.
# Current reliable multimodal default (Aug 2026):
OPENROUTER_FORMULA_MODEL=google/gemma-4-31b-it-20260402:free
