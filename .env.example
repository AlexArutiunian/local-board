# Copy this file to .env and replace the placeholder with your OpenRouter key.
# .env is gitignored and must never be committed.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Ox Alpha is currently free on OpenRouter and accepts image input.
# It is the predictable default for formula OCR; older experimental model values
# are migrated automatically by the server.
OPENROUTER_FORMULA_MODEL=stealth/ox-alpha
